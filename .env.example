# Liveness Verifier — contoh konfigurasi.
#
# Salin ke .env lalu ganti SEMUA nilai yang ditandai <ganti>. File .env tidak
# pernah di-commit (lihat .gitignore).
#
#   cp .env.example .env
#
# Nilai di bawah adalah default yang dipakai bila variabelnya tidak diset.
# Variabel yang ditandai WAJIB tidak punya default — service gagal boot bila
# kosong, dan itu memang disengaja.

# =============================================================================
# Kredensial infrastruktur (dipakai docker compose, bukan oleh aplikasi Go)
# =============================================================================
POSTGRES_USER=liveness
POSTGRES_PASSWORD=<ganti-password-postgres>
POSTGRES_DB=liveness

MINIO_ROOT_USER=liveness-minio
MINIO_ROOT_PASSWORD=<ganti-password-minio-minimal-8-karakter>

# =============================================================================
# HTTP
# =============================================================================
LV_HTTP_ADDR=:8080
LV_HTTP_READ_TIMEOUT=10s
LV_HTTP_WRITE_TIMEOUT=30s
LV_HTTP_IDLE_TIMEOUT=60s
LV_HTTP_REQUEST_TIMEOUT=20s
LV_HTTP_SHUTDOWN_TIMEOUT=10s

# Batas ukuran satu frame yang diunggah, dalam byte. Default 2 MiB.
LV_HTTP_MAX_FRAME_BYTES=2097152

# WAJIB. Daftar API key dipisah koma. Bangkitkan dengan:
#   openssl rand -hex 32
LV_API_KEYS=<ganti-api-key>

LV_RATE_LIMIT_PER_MIN=600

# =============================================================================
# Logging
# =============================================================================
# debug | info | warn | error
LV_LOG_LEVEL=info
# json | text  — pakai text untuk membaca log di terminal saat development
LV_LOG_FORMAT=json

# =============================================================================
# PostgreSQL
# =============================================================================
# WAJIB. Nilai di bawah cocok untuk docker compose; sesuaikan passwordnya.
LV_DATABASE_URL=postgres://liveness:<ganti-password-postgres>@postgres:5432/liveness?sslmode=disable
LV_DATABASE_MAX_CONNS=10
LV_DATABASE_MIN_CONNS=2
LV_DATABASE_CONNECT_TIMEOUT=5s

# =============================================================================
# Object storage (MinIO)
# =============================================================================
# Ketiganya WAJIB.
LV_OBJSTORE_ENDPOINT=minio:9000
LV_OBJSTORE_ACCESS_KEY=liveness-minio
LV_OBJSTORE_SECRET_KEY=<ganti-password-minio-minimal-8-karakter>
LV_OBJSTORE_BUCKET=liveness-artifacts
LV_OBJSTORE_REGION=us-east-1
LV_OBJSTORE_USE_SSL=false

# =============================================================================
# Inference
# =============================================================================
# stub = pipeline tiruan deterministik, tidak butuh file model sama sekali.
# onnx = model asli. Jalankan `modelctl download` lebih dulu.
LV_PIPELINE_MODE=stub

LV_MODELS_DIR=/models
LV_MODELS_POOL_SIZE=2
# 0 = biarkan ONNX Runtime yang menentukan jumlah thread.
LV_MODELS_INTRA_OP_THREADS=0

# det_500m.onnx adalah SCRFD-500M, dari paket buffalo_s.
#
# Bukan det_10g.onnx: yang berat butuh 116 ms per frame bahkan di 320x320,
# sementara yang ini hanya 73 ms di 640x640 penuh. Lebih cepat DAN resolusi
# lebih tinggi sekaligus, jadi tidak ada yang dikorbankan.
LV_MODEL_DETECTOR=det_500m.onnx
LV_MODEL_LANDMARKER=2d106det.onnx
LV_MODEL_EMBEDDER=w600k_r50.onnx

# Sisi persegi tempat frame di-letterbox sebelum deteksi. Harus kelipatan 32
# (stride terbesar detektor). Menurunkannya ke 320 memberi ~4x percepatan tapi
# wajah kecil/jauh jadi sulit terdeteksi.
LV_DETECTOR_INPUT_SIZE=640
LV_DETECTOR_NMS_IOU=0.4

# BELUM TERSEDIA. Tidak ada rilis ONNX resmi untuk MiniFASNetV2, jadi modelctl
# tidak bisa mengunduhnya. Lihat models/README.md — ini harus diputuskan
# sebelum T11.
LV_MODEL_ANTISPOOF=minifasnet_v2.onnx

# =============================================================================
# Gerbang kualitas gambar
# =============================================================================
LV_IMG_MAX_DECODED_PIXELS=16000000
LV_IMG_MIN_FACE_WIDTH_PX=112
LV_IMG_MIN_LAPLACIAN_VARIANCE=80
LV_IMG_MIN_BRIGHTNESS=40
LV_IMG_MAX_BRIGHTNESS=215
# Jarak Hamming pHash minimum antara dua frame agar dianggap berbeda.
LV_IMG_PHASH_MIN_DISTANCE=5

# =============================================================================
# Threshold liveness
#
# PERINGATAN: semua angka di bawah adalah estimasi dari literatur, BUKAN hasil
# pengukuran terhadap dataset berlabel. Jalankan `cmd/calibrate` (T30) sebelum
# mempercayainya untuk keputusan apa pun yang serius.
# =============================================================================
LV_LIVENESS_SESSION_TTL=90s
LV_LIVENESS_CHALLENGE_TIMEOUT=20s
LV_LIVENESS_CHALLENGE_COUNT=3

LV_LIVENESS_MIN_DETECTION_SCORE=0.60
LV_LIVENESS_MIN_SCORE=0.80

# Mata dianggap tertutup di bawah EAR_BLINK, terbuka lagi di atas EAR_OPEN.
# Dua ambang berbeda mencegah nilai di sekitar batas berkedip-kedip.
LV_LIVENESS_EAR_BLINK=0.21
LV_LIVENESS_EAR_OPEN=0.30
LV_LIVENESS_BLINK_MIN_FRAMES=2

LV_LIVENESS_YAW_TURN_DEG=25
LV_LIVENESS_PITCH_NOD_DEG=15
LV_LIVENESS_MAR_MOUTH_OPEN=0.55

# Kemiripan cosine minimum antar frame kunci dalam satu sesi. Ini yang mencegah
# wajah diganti di tengah sesi.
LV_LIVENESS_IDENTITY_COSINE_MIN=0.70

# =============================================================================
# Enrollment dan pencarian 1:N
# =============================================================================
LV_ENROLL_MATCH_COSINE_MIN=0.42
LV_ENROLL_SEARCH_TOP_K=5
LV_ENROLL_HNSW_M=16
LV_ENROLL_HNSW_EF_CONSTRUCTION=64
# Harus >= LV_ENROLL_SEARCH_TOP_K, kalau tidak recall turun diam-diam.
LV_ENROLL_HNSW_EF_SEARCH=40

# =============================================================================
# Token liveness (pengikat sesi yang lolos ke proses enrollment)
# =============================================================================
# WAJIB. Bangkitkan dengan: openssl rand -hex 32
LV_TOKEN_SECRET=<ganti-token-secret>
LV_TOKEN_TTL=5m
